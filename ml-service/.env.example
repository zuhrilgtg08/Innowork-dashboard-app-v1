# SortVision ML service — copy to .env and adjust.
# ICAM_MODEL_PATH is authoritative for Vision Sorting: best.pt with the
# exact class map {0: HIJAU, 1: KUNING, 2: MERAH}. The sort pipeline refuses
# to run (model_error, no arm/command) if it is missing or mismatched.
ICAM_MODEL_PATH=models/run-100/best.pt

# RTSP feed of the ICAM-300 (empty = simulator/synthetic fallback, local
# dev only). Production with hardware: rtsp://<camera-ip>:8550/video
ICAM_RTSP_URL=

# Optional HTTP(S) MJPEG preview endpoint tried when RTSP is empty or
# unreachable (OpenCV opens MJPEG-over-HTTP directly). Known context:
# 192.168.0.100:5001 — kept configurable, never assumed to be the exact
# YOLO frame source. Example: ICAM_STREAM_URL=http://192.168.0.100:5001/video
ICAM_STREAM_URL=

# Run the periodic infer→sort loop on service startup (required for
# autonomous sorting; the loop calls the full gated sort pipeline).
ICAM_AUTO_INFER=true

# YOLO confidence threshold passed to predict (0.05–0.95 clamp inside).
ICAM_CONF=0.85

# Laravel app base URL (signed ingest + preflight POSTs go here; must match
# the app's APP_URL) and path to Laravel's storage/app (model + dataset
# resolution, cwd-independent). Defaults below suit local dev.
LARAVEL_URL=http://127.0.0.1:8000
LARAVEL_STORAGE_PATH=../storage/app

# MQTT broker for arm/command + arm/status. Empty username keeps local
# anonymous Mosquitto working; production sets all three (must match the
# Laravel MQTT_* values consumed by ArmMqttService / mqtt:listen).
#
# LEGACY / OPT-IN ONLY: the production ML runtime no longer uses MQTT
# (monitoring is pull-based via /detections/latest + /stats/*). arm/command
# publishing happens only when SORTING_MQTT_ENABLED=true (requires
# paho-mqtt installed, which is intentionally absent from
# requirements.txt).
MQTT_BROKER=127.0.0.1
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
SORTING_MQTT_ENABLED=false

# Operational pick zone, normalized 0–1 frame fractions (default: central
# 60%). A sort command fires ONLY when the object center is inside.
# The Model Evaluation preview reuses these same bounds for its overlay.
PICK_ZONE_X_MIN=0.2
PICK_ZONE_X_MAX=0.8
PICK_ZONE_Y_MIN=0.2
PICK_ZONE_Y_MAX=0.8

# Anti-duplicate spatial quantization (normalized units) and minimum
# confidence (0–1) for a detection to trigger a sort command.
SORT_SPATIAL_TOLERANCE=0.05
SORT_MIN_CONFIDENCE=0.5
