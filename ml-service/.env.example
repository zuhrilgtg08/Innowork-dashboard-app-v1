# SortVision ML service — copy to .env and adjust.
# ICAM_MODEL_PATH is authoritative for Vision Sorting: best.pt covering
# exactly the semantic classes GREEN/YELLOW/RED (currently a YOLO11
# segmentation model, {0: GREEN, 1: YELLOW, 2: RED}, imgsz 512; Indonesian
# raw labels and any class-ID order are also accepted). A missing or
# mismatched model reports MODEL_ERROR — never a silent COCO fallback.
ICAM_MODEL_PATH=models/run-100/best.pt

# Real iCAM-300 RTSP endpoint for this project (local integration testing).
ICAM_RTSP_URL=rtsp://192.168.0.100:8550/video
# Leave empty only for local development with ICAM_ALLOW_SIMULATOR=true.
# If the configured source is unreachable, the service honestly reports
# camera_connected=false and camera_mode=OFFLINE (never LIVE, and no silent
# simulator substitution in production/demo mode).

# Simulator fallback gate (local development only, default off).
# false (production/demo intent): an unreachable real camera reports
# OFFLINE and no synthetic feed is generated.
# true: the looped sample video, webcam, or synthetic frames may be used,
# always labeled SIMULATOR, never LIVE.
ICAM_ALLOW_SIMULATOR=false

# Optional HTTP(S) MJPEG preview endpoint tried when RTSP is empty or
# unreachable (OpenCV opens MJPEG-over-HTTP directly). Known context:
# 192.168.0.100:5001 — kept configurable, never assumed to be the exact
# YOLO frame source. Example: ICAM_STREAM_URL=http://192.168.0.100:5001/video
ICAM_STREAM_URL=

# Run inference once on startup and exit (for manual testing only).
# The new continuous runtime is driven by the inference worker process,
# not by this setting. Leave disabled for the demo architecture.
ICAM_AUTO_INFER=false

# YOLO confidence threshold for the new best.pt (training/runtime report:
# 0.60). Still environment-driven — never hard-coded in inference code.
ICAM_CONF=0.60

# YOLO -> ESP32 TCP, matching ICAMXYClient (JSON + newline, reply OK).
# Run the ML service on a machine that can reach the ESP32's local network.
# Detection x/y are pixels; this robot protocol expects calibrated mm.
ROBOT_BRIDGE_ENABLED=false
ROBOT_ESP_HOST=192.168.67.174
ROBOT_ESP_PORT=5000
ROBOT_STREAM_HZ=10
ROBOT_MIN_CONFIDENCE=0.80
ROBOT_MAX_FRAME_AGE_S=1.0
ROBOT_SOCKET_TIMEOUT_S=1.0
ROBOT_RECONNECT_INTERVAL_S=2.0
# Required before enabling: [a,b,c,d,e,f], measured at the current resolution.
# Xmm=a*x_pixel+b*y_pixel+c; Ymm=d*x_pixel+e*y_pixel+f.
# Illustration ONLY; replace with measured calibration, not assumed scaling:
# ROBOT_PIXEL_TO_MM=[0.5,0,-160,0,-0.5,120]
# Existing PICK_ZONE_X_MIN/MAX and PICK_ZONE_Y_MIN/MAX also gate robot targets.
# See ../docs/YOLO_ROBOT_TCP.md.

# VPS deployment values (conceptual — adjust paths to the real host):
# LARAVEL_STORAGE_PATH=/var/www/sortvision/storage/app
# The service binds privately (127.0.0.1:8001); browsers must use the
# Laravel same-origin proxy routes (/ml/camera/*, /ml/stats/*, ...),
# never port 8001 directly.

# LEGACY — NOT USED BY CURRENT DEMO ARCHITECTURE:
# MQTT broker for arm/command + arm/status. The production ML runtime
# no longer uses MQTT for monitoring (pull-based via /detections/latest
# + /stats/*). arm/command publishing only happens when
# SORTING_MQTT_ENABLED=true (requires paho-mqtt, intentionally absent
# from requirements.txt). Do not enable unless legacy integration is required.
MQTT_BROKER=127.0.0.1
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
SORTING_MQTT_ENABLED=false
