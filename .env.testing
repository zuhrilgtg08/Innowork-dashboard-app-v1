APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:w/wzMukPZbYKdoIQjz/h7O80S4+A/2jJ9r+RD7CtpqI=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Untuk QR Code publik: jika menggunakan ngrok, set APP_URL ke URL ngrok
# lalu regenerate QR codes dengan: php artisan sortvision:regenerate-qr

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Python ML service (FastAPI + Ultralytics YOLO)
ML_SERVICE_URL=http://127.0.0.1:8001
ML_CALLBACK_SECRET=

# MQTT broker for the robotic arm (Opsi A). Broker (Mosquitto/EMQX) runs
# separately; Laravel is only publisher (arm/command) + consumer (mqtt:listen).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=sortvision
MQTT_USE_TLS=false
MQTT_BASE_TOPIC=arm
MQTT_CONNECT_TIMEOUT=3


# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# `.env` TIDAK boleh dicommit — hanya file contoh ini yang masuk repo.
#
# Semua variabel yang ingin dibaca dari kode klien wajib berawalan
# `EXPO_PUBLIC_`. Ingat: nilai `EXPO_PUBLIC_*` ikut ter-bundle ke aplikasi dan
# bisa dibaca siapa pun yang memegang build-nya — JANGAN taruh rahasia
# (API key privat, password broker produksi) di sini.

# --- Backend REST API -------------------------------------------------------
# Web browser / iOS simulator:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Android emulator (AVD) — 10.0.2.2 adalah alias host dari dalam emulator:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# --- MQTT (telemetry realtime, opsional) ------------------------------------
# Kosongkan `EXPO_PUBLIC_MQTT_WS_URL` untuk menonaktifkan MQTT (mobile akan
# polling REST saja). Mobile hanya SUBSCRIBE, tidak pernah publish.
EXPO_PUBLIC_MQTT_WS_URL=ws://10.0.2.2:9001
EXPO_PUBLIC_MQTT_BASE_TOPIC=arm
EXPO_PUBLIC_MQTT_USERNAME=
EXPO_PUBLIC_MQTT_PASSWORD=
